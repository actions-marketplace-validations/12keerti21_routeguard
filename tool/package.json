{
  "name": "routeguard-cli",
  "version": "2.2.0",
  "description": "Find broken authorisation in Express, Go and Python APIs: maps routes to their checks and flags the OWASP API Security Top 10",
  "type": "module",
  "bin": {
    "routeguard": "bin/cli.js"
  },
  "scripts": {
    "map": "node bin/cli.js",
    "test": "node --test test/*.test.js",
    "prepack": "cp ../README.md ../LICENSE ."
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@babel/parser": "^7.29.15",
    "web-tree-sitter": "0.25.10"
  },
  "keywords": [
    "security",
    "owasp",
    "api-security",
    "express",
    "go",
    "golang",
    "gin",
    "echo",
    "fiber",
    "chi",
    "python",
    "flask",
    "fastapi",
    "django",
    "authorization",
    "bola",
    "sast",
    "static-analysis"
  ],
  "author": "Keerti Deshpande",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/12keerti21/routeguard.git",
    "directory": "tool"
  },
  "homepage": "https://github.com/12keerti21/routeguard#readme",
  "bugs": {
    "url": "https://github.com/12keerti21/routeguard/issues"
  },
  "files": [
    "bin",
    "src",
    "vendor",
    "README.md",
    "LICENSE"
  ]
}
